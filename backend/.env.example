NODE_ENV=development
PORT=3000
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=nuestro_espacio
DB_PASSWORD=REEMPLAZAR
DB_DATABASE=nuestro_espacio
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_64_CARACTERES
RONALDO_EMAIL=ronaldomoradiaz08@gmail.com
SCARLET_EMAIL=scarreyesg22@gmail.com
# Solo se usan al crear cuentas que todavía no existen. Mínimo 4 caracteres.
RONALDO_INITIAL_PASSWORD=
SCARLET_INITIAL_PASSWORD=
# Sin estas variables, recuperación por correo informa indisponibilidad; el CLI funciona.
MAIL_USER=
MAIL_APP_PASSWORD=
MAIL_FROM=

# Fotos: en desarrollo se puede usar una ruta relativa al backend.
# En el servidor usa una ruta absoluta persistente fuera del frontend y de las versiones del código.
# PHOTO_STORAGE_DIR=/var/lib/nuestro-espacio/gallery

# Private videos (0.6.0). Same path as Nginx internal alias; never frontend/dist.
# VIDEO_STORAGE_DIR=/var/lib/nuestro-espacio/videos
# Profiles authorized to manage videos; both profiles can watch.
VIDEO_ADMIN_SLUGS=ronaldo
# 20 GiB per MP4, 1 GiB free disk reserve.
VIDEO_MAX_BYTES=21474836480
VIDEO_RESERVE_BYTES=1073741824
VIDEO_DOWNLOADS=false
# nginx in production. node for development or isolated HTTP Range tests.
# VIDEO_DELIVERY=nginx

# Optional synchronized playback. Off until Debian/browser verification.
WATCH_TOGETHER_ENABLED=false
# Prepare new compatible MP4 uploads without re-encoding (requires ffmpeg).
VIDEO_FASTSTART=true

# Mi rincón de mangas (0.8.0): enable only after additive migration and QA.
MANGAS_ENABLED=false
# Absolute persistent path; default is a mangas sibling of the photos directory.
# MANGA_STORAGE_DIR=/var/lib/nuestro-espacio/mangas
# Node streams files by default. Enable nginx only after adapting mangas.nginx.conf.
MANGA_DELIVERY=node
MANGA_PDF_MAX_BYTES=104857600
