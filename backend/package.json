{
  "name": "@nuestro-espacio/backend",
  "version": "0.8.1",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "db:migrate": "node dist/src/cli/manage.js migrate",
    "db:seed": "node dist/src/cli/manage.js seed",
    "user:reset": "node dist/src/cli/manage.js reset",
    "user:unlock": "node dist/src/cli/manage.js unlock",
    "user:list": "node dist/src/cli/manage.js list",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "exifr": "^7.1.3",
    "helmet": "^8.1.0",
    "mysql2": "^3.14.0",
    "nodemailer": "^10.0.16",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "typeorm": "~0.3.28",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^7.0.0",
    "@types/supertest": "^6.0.3",
    "sql.js": "^1.13.0",
    "supertest": "^7.1.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.9.3"
  }
}
